# Copy to .env and load with: node --env-file=.env src/mcp.mjs
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
# Explicit comma-separated allowlist of action destination hostnames. Required to deploy.
AAB_ALLOWED_ACTION_HOSTS=api.example.com
# n8n is the first fully implemented deployment provider.
N8N_BASE_URL=https://your-n8n.example.com
N8N_API_KEY=
# Optional: only for self-hosted n8n at loopback. Never expose its port publicly.
AAB_ALLOW_LOCAL_N8N=false
# HTTP API: default binds to loopback. Required even on loopback.
AAB_API_TOKEN=
AAB_API_HOST=127.0.0.1
AAB_API_PORT=8787

# Shared persistent SQLite state across CLI, MCP and API. Absolute path recommended.
# AAB_STATE_PATH=/home/user/.ai-automation-builder/state.sqlite
# Public API binding is intentionally blocked without explicit opt-in.
AAB_REMOTE_API_EXPLICIT_OPT_IN=false
