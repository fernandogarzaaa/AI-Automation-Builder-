{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "npm test"
  },
  "coverageAnalysis": "off",
  "concurrency": 2,
  "timeoutFactor": 3,
  "mutate": [
    "src/spec.mjs",
    "src/security.mjs",
    "src/state.mjs",
    "src/operations.mjs"
  ],
  "reporters": [
    "progress",
    "clear-text",
    "json"
  ],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  }
}
